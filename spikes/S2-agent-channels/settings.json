{
  "permissions": {
    "allow": [
      "Bash(curl -s http://127.0.0.1:47617/inbox)",
      "Bash(sleep 8)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I -S /home/sandro/work/privat/workbench/spikes/S2-agent-channels/hooks/user_prompt_submit.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I -S /home/sandro/work/privat/workbench/spikes/S2-agent-channels/hooks/post_tool_use.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I -S /home/sandro/work/privat/workbench/spikes/S2-agent-channels/hooks/stop.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 -I -S /home/sandro/work/privat/workbench/spikes/S2-agent-channels/hooks/rewake_poller.py",
            "asyncRewake": true,
            "timeout": 3600,
            "rewakeMessage": "Workbench:",
            "rewakeSummary": "workbench item"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I -S /home/sandro/work/privat/workbench/spikes/S2-agent-channels/hooks/notify.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
